{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "busters.gg",
  "version": "0.2.2",
  "identifier": "com.mirinnano.vry-desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "busters.gg",
        "url": "index.html",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 640,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required",
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https://media.valorant-api.com; connect-src ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$VIDEO/busters.gg/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "mirinnano",
    "copyright": "Copyright (c) 2021-2023 Zay Kenyon and Contributors",
    "shortDescription": "VALORANT のロビー、対戦、振り返り、ストアをまとめるデスクトップアプリ",
    "licenseFile": "../../../LICENSE",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "languages": [
          "Japanese",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "busters.gg"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEOTlBQTEzN0I2N0Y0QzQKUldURTlHZDdFNnFaN1JyRnhSZ3ErajUvYWVza05RdzhxdmxXR0s3ZFdCQVJyY3k1alJBRThaZ1gK",
      "endpoints": [
        "https://github.com/mirinnano/VALORANT-rank-yoinker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
